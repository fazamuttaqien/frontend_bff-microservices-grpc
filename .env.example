VITE_APP_NAME=frontend-bff-microservices-grpc
VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=0.1.0
VITE_BFF_BASE_URL=http://localhost:8080

# Observability is disabled by default. Set to true to enable Faro and tracing.
VITE_OBSERVABILITY_ENABLED=false
# Faro variables are only used when VITE_OBSERVABILITY_ENABLED=true.
VITE_FARO_URL=http://localhost:12348
VITE_FARO_APP_NAME=frontend-bff-microservices-grpc
VITE_FARO_APP_NAMESPACE=bff-microservices-grpc

# Docker host port only; not bundled into the Vite application.
FRONTEND_PORT=8080
